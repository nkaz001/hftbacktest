      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  CONCAT(f.symbol, '-', if(f.symbol = upper(f.symbol), 'bybit', 'binance')) AS symbol,\n  count() as fills,\n  sum(f.qty * f.price) as volume,\n  avg(f.qty * f.price) as avg_size,\n  countIf(f.is_maker = 1) * 100.0 / count() as maker_rate,\n  countIf(f.side = 1) as buys,\n  countIf(f.side = -1) as sells\nFROM hft.fills f\nWHERE f.exch_time >= $__fromTime AND f.exch_time <= $__toTime\nGROUP BY f.symbol\nORDER BY volume DESC",
          "refId": "A"
        }
      ],
      "title": "Trading Summary by Symbol",
      "type": "table"
    }

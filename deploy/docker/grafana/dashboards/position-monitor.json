          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  connector,\n  symbol,\n  argMax(position, timestamp) as position,\n  argMax(avg_price, timestamp) as avg_price,\n  argMax(mark_price, timestamp) as mark_price,\n  argMax(unrealized_pnl, timestamp) as unrealized_pnl,\n  max(timestamp) as last_update\nFROM (\n  SELECT connector, lower(symbol) as symbol, position, avg_price, mark_price, unrealized_pnl, timestamp\n  FROM hft.positions\n  WHERE timestamp >= now() - INTERVAL 1 HOUR\n)\nGROUP BY connector, symbol\nORDER BY last_update DESC",
          "refId": "A"
        }
      ],

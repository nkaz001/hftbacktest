          "queryType": "timeseries",
          "rawSql": "SELECT\n  time,\n  CONCAT(symbol, '-', connector) as symbol,\n  avg(position * mark_price) as notional\nFROM (\n  SELECT toStartOfMinute(timestamp) as time, connector, lower(symbol) as symbol, position, mark_price\n  FROM hft.positions\n  WHERE timestamp >= $__fromTime AND timestamp <= $__toTime\n)\nGROUP BY time, symbol, connector\nORDER BY time ASC",

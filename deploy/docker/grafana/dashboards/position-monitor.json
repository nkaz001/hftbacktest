          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(abs(pos * mp)) as total_notional\nFROM (\n  SELECT connector, symbol, argMax(position, timestamp) as pos, argMax(mark_price, timestamp) as mp\n  FROM (\n    SELECT connector, lower(symbol) as symbol, position, mark_price, timestamp\n    FROM hft.positions\n    WHERE timestamp >= now() - INTERVAL 5 MINUTE\n  )\n  GROUP BY connector, symbol\n  HAVING pos != 0\n)",
          "refId": "A"
        }
      ],
      "title": "Total Notional Exposure",
      "type": "stat"

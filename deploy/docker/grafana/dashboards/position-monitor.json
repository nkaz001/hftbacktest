          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(unrealized_pnl) as total_unrealized_pnl\nFROM (\n  SELECT connector, symbol, argMax(unrealized_pnl, timestamp) as unrealized_pnl\n  FROM (\n    SELECT connector, lower(symbol) as symbol, unrealized_pnl, timestamp\n    FROM hft.positions\n    WHERE timestamp >= now() - INTERVAL 1 HOUR\n  )\n  GROUP BY connector, symbol\n)",
          "refId": "A"
        }
      ],
      "title": "Total Unrealized PnL",
      "type": "stat"

          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  connector,\n  symbol,\n  sumIf(income, income_type = 'REALIZED_PNL') as pnl,\n  sumIf(income, income_type = 'COMMISSION') as commission,\n  sumIf(income, income_type = 'FUNDING_FEE') as funding,\n  sum(income) as net\nFROM hft.income\nWHERE timestamp >= $__fromTime AND timestamp <= $__toTime\nGROUP BY connector, symbol\nORDER BY net DESC",

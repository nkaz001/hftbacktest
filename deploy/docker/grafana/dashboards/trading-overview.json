          "rawSql": "SELECT \n  toStartOfMinute(create_time) AS time,\n  CONCAT(symbol, '-', if(symbol = upper(symbol), 'bybit', 'binance')) AS symbol,\n  quantile(0.5)(latency_ns) / 1000000 AS p50_ms,\n  quantile(0.95)(latency_ns) / 1000000 AS p95_ms,\n  quantile(0.99)(latency_ns) / 1000000 AS p99_ms\nFROM hft.orders \nWHERE $__timeFilter(create_time) AND latency_ns > 0\nGROUP BY time, symbol\nORDER BY time",

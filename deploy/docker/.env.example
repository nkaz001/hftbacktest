# HFT System Environment Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Exchange API Credentials
# =============================================================================
# Only fill in the credentials for the exchange you are using.
# The connector type is configured in config/cluster.toml

# -----------------------------------------------------------------------------
# Binance Futures (for connector type: binancefutures)
# -----------------------------------------------------------------------------
# Get keys from https://testnet.binancefuture.com/ (testnet)
# or https://www.binance.com/en/my/settings/api-management (mainnet)

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# -----------------------------------------------------------------------------
# Bybit Linear Futures (for connector type: bybit)
# -----------------------------------------------------------------------------
# Get keys from https://testnet.bybit.com/ (testnet)
# or https://www.bybit.com/app/user/api-management (mainnet)

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# =============================================================================
# Server Configuration (OPTIONAL)
# =============================================================================

# JWT secret for authentication (generate a random string)
# If not set, authentication may not work properly
JWT_SECRET=change_me_to_a_random_string_in_production

# Server port (default: 3000)
# SERVER_PORT=3000

# Disable authentication for development (NOT for production!)
# NO_AUTH=true

# =============================================================================
# Logging (OPTIONAL)
# =============================================================================

# Rust log level: error, warn, info, debug, trace
RUST_LOG=info

# =============================================================================
# ClickHouse (OPTIONAL - defaults are usually fine)
# =============================================================================

# ClickHouse connection URL
# CLICKHOUSE_URL=http://clickhouse:8123

# Bybit Mainnet API Credentials
# Copy this file to .env.mainnet and fill in your actual API keys
# IMPORTANT: Never commit .env.mainnet to version control!

# Bybit API Key (from https://www.bybit.com/app/user/api-management)
BYBIT_API_KEY=your_api_key_here

# Bybit API Secret
BYBIT_SECRET=your_api_secret_here

# Notes:
# 1. Create API key with the following permissions:
#    - Read/Write for Contract (for trading)
#    - Read for Wallet (for position/balance)
# 2. Recommended: Enable IP whitelist for your server
# 3. Start with small position limits in API settings
